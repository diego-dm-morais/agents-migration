{
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "superpowers@claude-plugins-official": false,
    "andrej-karpathy-skills@karpathy-skills": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh .claude/skills/migrate/scripts/check.sh status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && sh .claude/skills/migrate/scripts/check.sh contract"
          }
        ]
      }
    ]
  }
}
